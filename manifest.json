{
  "manifest_version": 3,
  "name": "RTA Test Manager",
  "version": "1.25.1",
  "description": "RTA Test Manager com workflow em lote, cores por status, configurações e capturador de rede.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "js": [
        "network-recorder-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "js": [
        "pagination-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "css": [
        "pagination.css",
        "table-enhancer.css",
        "network-recorder.css",
        "extension-settings.css",
        "workflow-batch.css"
      ],
      "js": [
        "pagination.js",
        "table-enhancer.js",
        "network-recorder.js",
        "extension-settings.js",
        "workflow-batch.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
