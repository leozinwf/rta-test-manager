{
  "manifest_version": 3,
  "name": "RTA Test Manager",
  "version": "1.27.4",
  "description": "RTA Test Manager com Workflow seguro, atribuição de QA e reprovação em lote.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "js": [
        "core/page-bridge.js",
        "core/network-recorder-bridge.js",
        "core/pagination-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dootax.com.br/dootax/*"
      ],
      "css": [
        "styles/test-manager.css",
        "styles/pagination.css",
        "styles/table-enhancer.css",
        "styles/network-recorder.css",
        "styles/settings.css",
        "styles/workflow-batch.css",
        "styles/workflow-safe.css"
      ],
      "js": [
        "features/test-manager.js",
        "features/pagination.js",
        "features/table-enhancer.js",
        "features/network-recorder.js",
        "features/settings.js",
        "features/workflow-batch.js",
        "features/workflow-safe.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
